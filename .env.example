# Modelo do arquivo .env local. Copie para .env e preencha os valores (o .env nunca é versionado).
# Não reutilize chaves nem senhas de outros projetos. As credenciais entram em strings de conexão:
# use só letras e números ou codifique os demais caracteres para URL.

# MongoDB: administrador do contêiner e usuário do Api.Agente no banco auditoria_agente
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=

# PostgreSQL: administrador do contêiner e usuário do Api.Agente, com acesso só ao schema consumo
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=

# Provedor de IA: Simulado (só em Development) ou OpenAI
Ia__Provedor=Simulado

# OpenAI: obrigatórios só com Ia__Provedor=OpenAI; o modelo não tem valor padrão (DP-05)
OpenAI__ApiKey=
OpenAI__Modelo=

# Integração MCP desabilitada nesta feature
Mcp__Habilitado=false

# URL publicada no Agent Card
A2A__UrlPublica=http://localhost:5310

# Origem de um frontend web autorizado a chamar as rotas /api/v1 pelo navegador (FR-052e).
# Esquema + host + porta, sem barra final. A SOFIA chamando pelo backend não precisa disto.
# Cors__AllowedOrigins__0=http://localhost:4200

# Limites de entrada (FR-004, FR-005) e retenção do contexto do usuário (FR-060)
Limites__TamanhoTotalBytes=5242880
Limites__QuantidadeArquivos=20
ContextoUsuario__RetencaoInatividade=90.00:00:00
