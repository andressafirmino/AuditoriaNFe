<Project>

  <!--
    Versões exatas de research §1, consultadas no NuGet. Pacotes em pré-lançamento só mudam em PR
    próprio com a execução completa dos testes de contrato A2A.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Microsoft Agent Framework">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.26.0" />
  </ItemGroup>

  <ItemGroup Label="Hosting e cliente A2A (pré-lançamento)">
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="1.26.0-preview.261023.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.AspNetCore" Version="1.26.0-preview.261023.1" />
    <PackageVersion Include="Microsoft.Agents.AI.A2A" Version="1.26.0-preview.261023.1" />
  </ItemGroup>

  <ItemGroup Label="IA, MCP e persistência">
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.3.0" />
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Mesma versão do EF Core exigida pelo Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup Label="Opções e configuração">
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Host">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>

</Project>
