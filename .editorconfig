root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# XSDs oficiais: conferidos byte a byte pelo SHA-256 do manifesto; o editor não altera nada.
[src/AuditoriaNFe.Infrastructure/Schemas/NFe/**.xsd]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

dotnet_naming_rule.campos_privados.symbols = campos_privados
dotnet_naming_rule.campos_privados.style = sublinhado_camel
dotnet_naming_rule.campos_privados.severity = suggestion
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.sublinhado_camel.capitalization = camel_case
dotnet_naming_style.sublinhado_camel.required_prefix = _
